{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "default_agent": "build",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "unityMCP": {
      "enabled": false
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*_records*": "deny",
      "*rehearsal_records*": "deny",
      "qa/*": "deny",
      "QA/*": "deny",
      "*.glb": "deny",
      "*.fbx": "deny",
      "*.png": "deny",
      "*.jpg": "deny",
      "*.zip": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "deny",
      "main.js": "allow",
      "*/main.js": "allow",
      "*\\main.js": "allow",
      "course.js": "allow",
      "*/course.js": "allow",
      "*\\course.js": "allow",
      "physics.js": "allow",
      "*/physics.js": "allow",
      "*\\physics.js": "allow",
      "physics.test.js": "allow",
      "*/physics.test.js": "allow",
      "*\\physics.test.js": "allow",
      "character.js": "allow",
      "*/character.js": "allow",
      "*\\character.js": "allow",
      "world.js": "allow",
      "*/world.js": "allow",
      "*\\world.js": "allow",
      "demo.js": "allow",
      "*/demo.js": "allow",
      "*\\demo.js": "allow",
      "index.html": "allow",
      "*/index.html": "allow",
      "*\\index.html": "allow",
      "style.css": "allow",
      "*/style.css": "allow",
      "*\\style.css": "allow",
      "qa_local/*": "deny"
    },
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "node --version": "allow",
      "node start.mjs": "allow",
      "npm run start": "allow",
      "node --test physics.test.js": "allow",
      "npm test": "allow"
    },
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "question": "deny"
  }
}
